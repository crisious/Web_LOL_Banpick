RIOT_API_KEY=RGAPI-your-development-key
PORT=8123
# 로컬 기본값은 127.0.0.1. Render/Fly/Railway 같은 클라우드에서는 0.0.0.0 필요.
# HOST=0.0.0.0

# 외부 데모 보호 모드:
# - full: 로컬 개발 기본값. 기존 API 모두 활성.
# - readonly: 저장 샘플만 공개. Riot 조회/샘플 생성/champion-history 차단.
# - protected: Authorization: Bearer 또는 X-Demo-Token 이 PUBLIC_DEMO_TOKEN과 같을 때만 live API 허용.
# PUBLIC_DEMO_MODE=readonly
# PUBLIC_DEMO_TOKEN=change-me

# Cloudflare Tunnel / reverse proxy 뒤에서 CF-Connecting-IP, X-Forwarded-For를 rate-limit IP로 사용할 때만 1.
# TRUST_PROXY=1

# Phase 30: Codex CLI를 사용할 수 없거나(노후 버전, 모델 미호환, 인증 부재 등)
# 매번 실패하는 환경에서 1로 설정하면 Codex 호출을 건너뛰고 Claude 단독으로
# 분석. Track C 측정은 그대로 작동. AI Comparison 패널은 Claude-only로 표시.
# AGENT_DISABLE_CODEX=1

# Phase 25 fix: 추가 CLI 설치 경로 (path.delimiter로 구분). 보통 .local/bin과
# .codex/.sandbox-bin은 자동 추가되므로 불필요. claude/codex가 비표준 위치에
# 있을 때만 설정.
# EXTRA_CLI_PATH=C:\Tools\codex\bin
